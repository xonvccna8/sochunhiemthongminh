rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Tài khoản giáo viên chủ nhiệm đã được nhà trường duyệt trước.
    function isPrimaryHomeroomTeacherAccount() {
      return signedIn()
        && request.auth.token.keys().hasAll(['email'])
        && request.auth.token.email == 'gvxo@gmail.com';
    }

    function writesPrimaryHomeroomTeacherAccount(userId) {
      return isOwner(userId)
        && isPrimaryHomeroomTeacherAccount()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == 'gvxo@gmail.com'
        && request.resource.data.role == 'teacher'
        && request.resource.data.className == '10C3'
        && request.resource.data.schoolYear == '2026 - 2027';
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isPharmacist() {
      return hasUserProfile() && userRole() == 'pharmacist';
    }

    // Giữ nguyên hành vi hiện tại cho các phần dữ liệu cũ.
    function isTeacher() {
      return signedIn();
    }

    // Giáo viên của ứng dụng Sổ Chủ Nhiệm phải có role = teacher.
    function isHomeroomTeacher() {
      return hasUserProfile() && userRole() == 'teacher';
    }

    function teacherClassName() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.get('className', '10C3');
    }

    function teacherSchoolYear() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.get('schoolYear', '2026 - 2027');
    }

    function managesHomeroomProfile(profileData) {
      return isHomeroomTeacher()
        && profileData.className == teacherClassName()
        && profileData.schoolYear == teacherSchoolYear();
    }

    function ownsHomeroomProfile() {
      return signedIn() && request.auth.uid == resource.data.ownerId;
    }

    function writesOwnFixedHomeroomProfile() {
      return signedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.className == '10C3'
        && request.resource.data.schoolYear == '2026 - 2027'
        && request.resource.data.teacherName == 'Nguyễn Văn Xô';
    }

    function hasSchoolProfile(schoolId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)
        );
    }

    function belongsToSchool(schoolId) {
      return signedIn()
        && (
          (
            request.auth.token.keys().hasAll(['schoolId'])
            && request.auth.token.schoolId == schoolId
          )
          || (
            hasSchoolProfile(schoolId)
            && get(
              /databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)
            ).data.get('schoolId', schoolId) == schoolId
          )
        );
    }

    function isSchoolTeacherOrAdmin(schoolId) {
      return belongsToSchool(schoolId)
        && (
          (
            request.auth.token.keys().hasAll(['role'])
            && request.auth.token.role in ['teacher', 'admin']
          )
          || (
            hasSchoolProfile(schoolId)
            && get(
              /databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)
            ).data.get('role', '') in ['teacher', 'admin']
          )
        );
    }

    function isStudentForSchool(schoolId) {
      return belongsToSchool(schoolId)
        && (
          (
            request.auth.token.keys().hasAll(['role'])
            && request.auth.token.role == 'student'
          )
          || (
            hasSchoolProfile(schoolId)
            && get(
              /databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)
            ).data.get('role', '') == 'student'
          )
        );
    }

    function isLinkedToStudent(schoolId, studentId) {
      return belongsToSchool(schoolId)
        && (
          (
            request.auth.token.keys().hasAll(['linkedStudentIds'])
            && studentId in request.auth.token.linkedStudentIds
          )
          || (
            hasSchoolProfile(schoolId)
            && get(
              /databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)
            ).data.keys().hasAll(['linkedStudentIds'])
            && studentId in get(
              /databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)
            ).data.linkedStudentIds
          )
        );
    }

    // ===== 1. Ứng dụng Nhà thuốc =====
    match /users/{userId} {
      allow get: if isOwner(userId) || isPharmacist();
      allow list: if isPharmacist() || signedIn();
      // Role đặc quyền chỉ do quản trị viên cấp, ngoại trừ email GVCN đã duyệt.
      allow create: if (
          isOwner(userId)
          && !(request.resource.data.get('role', 'student')
            in ['teacher', 'pharmacist', 'admin'])
        ) || writesPrimaryHomeroomTeacherAccount(userId);
      allow update: if isPharmacist()
        || (
          isOwner(userId)
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('className', '') == resource.data.get('className', '')
          && request.resource.data.get('schoolYear', '') == resource.data.get('schoolYear', '')
        )
        || writesPrimaryHomeroomTeacherAccount(userId);
      allow delete: if isPharmacist();
    }

    match /medicines/{medicineId} {
      allow read: if signedIn();
      allow write: if isPharmacist();
    }

    match /stockTransactions/{transactionId} {
      allow read, create: if isPharmacist();
      allow update, delete: if false;
    }

    match /prescriptions/{prescriptionId} {
      allow create: if signedIn()
        && (
          isPharmacist()
          || request.resource.data.patientId == request.auth.uid
        );

      allow read: if signedIn()
        && (
          isPharmacist()
          || resource.data.patientId == request.auth.uid
          || resource.data.doctorId == request.auth.uid
        );

      allow update, delete: if isPharmacist();
    }

    // ===== 2. Ứng dụng Giám Hộ Số: dữ liệu thư mục gốc =====
    match /students/{docId} {
      allow read, write: if signedIn();
    }

    match /attendance/{docId} {
      allow read, write: if signedIn();
    }

    match /attendanceSessions/{docId} {
      allow read, write: if signedIn();
    }

    match /menus/{docId} {
      allow read, write: if signedIn();
    }

    match /alerts/{docId} {
      allow read, write: if signedIn();
    }

    match /faceProfiles/{docId} {
      allow read, write: if signedIn();
    }

    match /careNotes/{docId} {
      allow read, write: if signedIn();
    }

    // ===== 3. Hồ sơ tài khoản trong trường =====
    match /schools/{schoolId}/users/{uid} {
      allow read, write: if signedIn();
    }

    // ===== 4. Báo cáo sức khỏe do học sinh gửi =====
    match /schools/{schoolId}/healthIncidents/{incidentId} {
      allow read: if signedIn();

      allow create: if isSchoolTeacherOrAdmin(schoolId)
        || (
          isStudentForSchool(schoolId)
          && request.resource.data.keys().hasOnly([
            'id', 'studentId', 'studentName', 'className', 'roomNumber',
            'category', 'severity', 'symptoms', 'actionTaken',
            'guardianNotified', 'status', 'occurredAt', 'followUpAt',
            'createdAt', 'updatedAt', 'createdByUid', 'createdByName',
            'createdByRole', 'source', 'requiresTeacherReview',
            'serverRecordedAt'
          ])
          && request.resource.data.id == incidentId
          && isLinkedToStudent(schoolId, request.resource.data.studentId)
          && exists(
            /databases/$(database)/documents/schools/$(schoolId)/students/$(request.resource.data.studentId)
          )
          && request.resource.data.studentName == get(
            /databases/$(database)/documents/schools/$(schoolId)/students/$(request.resource.data.studentId)
          ).data.get('name', '')
          && request.resource.data.className == get(
            /databases/$(database)/documents/schools/$(schoolId)/students/$(request.resource.data.studentId)
          ).data.get('className', '')
          && request.resource.data.roomNumber == get(
            /databases/$(database)/documents/schools/$(schoolId)/students/$(request.resource.data.studentId)
          ).data.get('roomNumber', '')
          && request.resource.data.category in [
            'Sức khỏe', 'Tâm lý', 'Bắt nạt', 'Tai nạn', 'An toàn'
          ]
          && request.resource.data.severity in [
            'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'
          ]
          && request.resource.data.symptoms is string
          && request.resource.data.symptoms.size() >= 5
          && request.resource.data.symptoms.size() <= 1500
          && request.resource.data.actionTaken == ''
          && request.resource.data.guardianNotified == false
          && request.resource.data.status == 'OPEN'
          && request.resource.data.followUpAt == 0
          && request.resource.data.occurredAt is int
          && request.resource.data.occurredAt == request.resource.data.createdAt
          && request.resource.data.createdAt == request.resource.data.updatedAt
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByName == request.resource.data.studentName
          && request.resource.data.createdByRole == 'student'
          && request.resource.data.source == 'student_self_report'
          && request.resource.data.requiresTeacherReview == true
          && request.resource.data.serverRecordedAt == request.time
        );

      allow update, delete: if isSchoolTeacherOrAdmin(schoolId);
    }

    // Giữ nguyên quyền hiện tại cho các collection trường học khác,
    // nhưng loại healthIncidents để rule riêng phía trên có hiệu lực.
    match /schools/{schoolId}/{collectionId}/{document=**} {
      allow read, write: if signedIn() && collectionId != 'healthIncidents';
    }

    // ===== 5. Ứng dụng Sổ Chủ Nhiệm Online =====
    match /profiles/{userId} {
      allow get: if managesHomeroomProfile(resource.data) || isOwner(userId);
      allow list: if managesHomeroomProfile(resource.data);
      allow create: if managesHomeroomProfile(request.resource.data)
        || (isOwner(userId) && writesOwnFixedHomeroomProfile());
      allow update: if (
          managesHomeroomProfile(resource.data)
          && managesHomeroomProfile(request.resource.data)
        )
        || (isOwner(userId) && writesOwnFixedHomeroomProfile());
      allow delete: if managesHomeroomProfile(resource.data);
    }

    match /publicProfiles/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if writesOwnFixedHomeroomProfile()
        && request.resource.data.shareToken == token;
      allow update: if (
          managesHomeroomProfile(resource.data)
          && managesHomeroomProfile(request.resource.data)
        )
        || (
          ownsHomeroomProfile()
          && writesOwnFixedHomeroomProfile()
          && request.resource.data.shareToken == token
        );
      allow delete: if managesHomeroomProfile(resource.data) || ownsHomeroomProfile();
    }

    // ===== 6. Mặc định: chặn mọi truy cập khác =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
