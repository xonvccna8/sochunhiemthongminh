rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function teacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function ownsProfile() {
      return signedIn() && request.auth.uid == resource.data.ownerId;
    }

    function writesOwnFixedProfile() {
      return signedIn()
        && request.auth.uid == request.resource.data.ownerId
        && request.resource.data.className == '10C3'
        && request.resource.data.schoolYear == '2026 - 2027'
        && request.resource.data.teacherName == 'Nguyễn Văn Xô';
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || teacher());
      allow list: if teacher();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'student';
      allow update: if teacher()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role);
      allow delete: if false;
    }

    match /profiles/{userId} {
      allow get: if teacher() || (signedIn() && request.auth.uid == userId);
      allow list: if teacher();
      allow create, update: if teacher()
        || (signedIn() && request.auth.uid == userId && writesOwnFixedProfile());
      allow delete: if teacher();
    }

    match /publicProfiles/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if writesOwnFixedProfile();
      allow update: if teacher() || ownsProfile();
      allow delete: if teacher() || ownsProfile();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
